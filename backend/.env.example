# --- Database ---
# MongoDB Atlas connection string (or mongodb://localhost:27017 for a local server)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=deal_rescue

# --- Auth ---
# Long random string. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# --- AI (Groq) ---
# Leave GROQ_API_KEY empty to run with the built-in rule-based analysis only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=60

# --- Web ---
# Comma-separated list of frontend origins allowed to call the API
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Uploads ---
MAX_UPLOAD_MB=10

# --- Analysis ---
# Days of customer silence before a deal counts as quiet
SILENCE_DAYS=14
# How many deals the background worker analyzes at the same time
ANALYSIS_CONCURRENCY=3

# --- Daily check: flags deals whose risk changed over time (never re-runs analysis by itself) ---
MONITOR_ENABLED=true
MONITOR_INTERVAL_MINUTES=60

# --- Optional: SMTP for sending approved drafts. Leave empty to copy / open in your mail app instead. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
